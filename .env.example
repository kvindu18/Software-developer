# Firebase Web App config (safe to expose to browser when API key is restricted to Firebase services)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Run/API URL. Leave empty when served behind the same origin.
VITE_API_URL=

# Server-side Google Cloud project identifier
GOOGLE_CLOUD_PROJECT=
